# syntax=docker/dockerfile:1
# ==================================================================
# pi-like-os：一台「像剛灌好的 Raspberry Pi 4」的 Debian trixie 容器
#
# 只預裝讓系統像一台 Pi 的最少東西（sshd、sudo、python3、使用者 pi）。
# virtualenvwrapper、pip 套件、MariaDB、phpMyAdmin 一律不預裝，
# 請 ssh 進來照實驗步驟自己安裝。
#
# 支援 linux/arm64（Apple Silicon Mac）與 linux/amd64（Windows）。
# ==================================================================

# ------------------------------------------------------------------
# 第一段：用真正的 gpiozero 預先產生 pinout 的輸出
# （這一段只在建立 image 時使用，gpiozero 不會留在最後的 image 裡）
# ------------------------------------------------------------------
# 基底 image 固定版本（Debian 13.7，2026-11-04）：標籤方便人看，@sha256 保證內容完全一樣。
# 要升級時改這一行。
ARG DEBIAN_IMAGE=debian:trixie-20261104@sha256:9c6e381421d0f48d1b8133e573f33c185ee16cbf505eda9c4a8a4791b25ea8a6

FROM ${DEBIAN_IMAGE} AS pinout
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates \
 && python3 -m venv /tmp/venv \
 && /tmp/venv/bin/pip install --no-cache-dir gpiozero==2.0.1.post3 colorzero==2.0
# b03115 = Raspberry Pi 4 Model B rev 1.5，2GB，BCM2711
RUN mkdir /out \
 && export COLUMNS=80 \
 && /tmp/venv/bin/pinout -r b03115 --color      > /out/pinout.color \
 && /tmp/venv/bin/pinout -r b03115 --monochrome > /out/pinout.mono \
 && /tmp/venv/bin/pinout --help                 > /out/pinout.help

# ------------------------------------------------------------------
# 第二段：取得 tini（小型 init，負責回收殭屍程序、轉送關機訊號）
# Docker 內建的 init 會掛在 /sbin，但 /sbin 是指向 /usr 的連結，/usr 又是 volume，
# 所以改用自己帶的 tini，放在不屬於 volume 的 /pisim
# ------------------------------------------------------------------
FROM ${DEBIAN_IMAGE} AS tini
RUN apt-get update && apt-get install -y --no-install-recommends tini

# ------------------------------------------------------------------
# 第三段：真正的系統
# ------------------------------------------------------------------
FROM ${DEBIAN_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive

# Docker 官方 debian image 為了縮小體積做了一些調整，這裡還原成一般 Debian 的樣子：
#   policy-rc.d       會阻止 apt 安裝後自動啟動服務（真機裝完 MariaDB 會自動啟動）
#   docker-clean 等   會刪除 apt 下載的套件檔、語系檔
RUN rm -f /usr/sbin/policy-rc.d \
          /etc/apt/apt.conf.d/docker-* \
          /etc/dpkg/dpkg.cfg.d/docker-*

# 最少的系統套件：ssh、sudo、系統內建的 python3，以及一般 Pi 上就有的基本工具
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        openssh-server sudo python3 \
        ca-certificates curl wget git nano vim-tiny less \
        procps psmisc iproute2 iputils-ping \
        locales tzdata bash-completion man-db \
 && rm -rf /var/lib/apt/lists/*

# 語系與時區：Raspberry Pi OS 預設 en_GB.UTF-8；另外產生 zh_TW.UTF-8 以免 ssh 帶入語系時出現警告
RUN sed -i -E 's/^# *(en_GB.UTF-8|en_US.UTF-8|zh_TW.UTF-8) /\1 /' /etc/locale.gen \
 && locale-gen \
 && update-locale LANG=en_GB.UTF-8 \
 && ln -sf /usr/share/zoneinfo/Asia/Taipei /etc/localtime \
 && echo Asia/Taipei > /etc/timezone

# 使用者 pi：群組與 Raspberry Pi OS 相同，sudo 不需要密碼（真機也是如此）
RUN for g in gpio i2c spi netdev render input; do groupadd -f -r "$g"; done \
 && useradd -m -s /bin/bash -u 1000 \
        -G adm,dialout,cdrom,sudo,audio,video,plugdev,games,users,input,render,netdev,gpio,i2c,spi pi \
 && echo 'pi:raspberry' | chpasswd \
 && echo 'pi ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/010_pi-nopasswd \
 && chmod 0440 /etc/sudoers.d/010_pi-nopasswd

# ssh：主機金鑰改在第一次開機時產生，每台電腦的金鑰才會不同
RUN rm -f /etc/ssh/ssh_host_* \
 && printf 'PasswordAuthentication yes\n' > /etc/ssh/sshd_config.d/pisim.conf

# ------------------------------------------------------------------
# 模擬工具都放在 /pisim。
# /etc、/usr、/var、/home 等目錄會存進 volume（像一張 SD 卡），
# /pisim 不在 volume 裡，更新 image 時模擬工具會跟著更新，你裝的東西也不會受影響。
# 系統路徑裡只放指向 /pisim 的連結。
# ------------------------------------------------------------------
COPY rootfs/pisim/ /pisim/
COPY --from=pinout /out/ /pisim/share/
COPY --from=tini /usr/bin/tini /pisim/bin/tini
RUN chmod 0755 /pisim/init.sh /pisim/links.sh /pisim/bin/* \
 && for n in poweroff halt shutdown; do ln -sf reboot "/pisim/bin/$n"; done \
 && /pisim/links.sh

# 系統設定：pip 來源、Jupyter、Gradio
COPY rootfs/etc/ /etc/
RUN echo 'GRADIO_SERVER_NAME=0.0.0.0' >> /etc/environment \
 && printf 'Raspberry Pi reference 2025-10-01\nGenerated by pi-like-os (Debian trixie)\n' > /etc/rpi-issue \
 && printf '\n（pi-like-os 模擬環境）虛擬麵包板：http://localhost:8080\n\n' >> /etc/motd

EXPOSE 22
ENTRYPOINT ["/pisim/bin/tini", "--"]
CMD ["/pisim/init.sh"]
